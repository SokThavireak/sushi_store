<footer class="bg-[#0B0C10] border-t border-white/10 text-sand pt-20 pb-12">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16">
    
    <!-- TOP ROW: Monogram, Quotes & Newsletter -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pb-16 border-b border-white/5">
      
      <!-- Brand & Japanese Seal -->
