            <input 
              type="email" 
              required
              placeholder="YOUR EMAIL ADDRESS" 
              class="w-full bg-transparent text-xs tracking-[0.2em] uppercase text-sand placeholder:text-sand-muted/50 focus:outline-none"
            />
            <button type="submit" class="text-gold hover:text-sand transition-colors pl-4 text-xs uppercase tracking-[0.2em] font-cinzel">
              Join
            </button>
          </div>
        </form>
        <p class="text-[10px] text-sand-muted/60 tracking-wider">
          Discretion assured. Frequency strictly curated.
        </p>
