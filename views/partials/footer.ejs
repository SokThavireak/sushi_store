            <li><a href="/" class="hover:text-sand transition-colors">The Philosophy</a></li>
            <li><a href="#culinary-showcase" class="hover:text-sand transition-colors">Omakase</a></li>
            <li><a href="#omakase-sets" class="hover:text-sand transition-colors">Tasting Flights</a></li>
            <li><a href="#chef-philosophy" class="hover:text-sand transition-colors">The Chef</a></li>
