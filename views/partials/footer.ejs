          <ul class="space-y-2.5 text-sand-muted">
            <li><a href="#reservations" class="hover:text-sand transition-colors">Private Dining</a></li>
            <li><a href="/location" class="hover:text-sand transition-colors">Ginza Atelier</a></li>
            <li><a href="/orders" class="hover:text-sand transition-colors">Bespoke Orders</a></li>
            <li><a href="/about" class="hover:text-sand transition-colors">Press & Awards</a></li>
          </ul>
        </div>
      </div>

      <!-- Newsletter With Single-Line Gold Input -->
      <div class="lg:col-span-4 space-y-5">
