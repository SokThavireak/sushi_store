<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : "Murakami Atelier · Haute Gastronomie Japonaise" %></title>
    
    <!-- Editorial & Modern Architectural Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              canvas: {
                DEFAULT: "#0B0C10",
                card: "#12141A",
                surface: "#181A22",
                elevated: "#1D202A",
              },
              gold: {
                300: "#E3CCA8",
                DEFAULT: "#C5A880",
                600: "#A68962",
                dark: "#7A6342",
              },
              sand: {
                DEFAULT: "#F5F5F0",
                muted: "#9E9EA7",
                dim: "#6B6C75",
              },
              crimson: {
                DEFAULT: "#8B2635",
                dark: "#5E1722",
              }
            },
            fontFamily: {
              serif: ['"Cormorant Garamond"', 'serif'],
              cinzel: ['"Cinzel"', 'serif'],
              sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            },
            letterSpacing: {
              widest: '0.2em',
              ultra: '0.3em',
            }
          },
        },
      };
    </script>

    <style>
      :root {
        --color-gold: #C5A880;
        --color-canvas: #0B0C10;
        --color-card: #12141A;
        --color-sand: #F5F5F0;
      }

      * {
        box-sizing: border-box;
      }

      body {
        background-color: #0B0C10;
        color: #F5F5F0;
        font-family: "Plus Jakarta Sans", sans-serif;
        overflow-x: hidden;
      }

      ::selection {
        background: #C5A880;
        color: #0B0C10;
      }

      /* Custom Haute-Cuisine Scrollbar */
      ::-webkit-scrollbar {
        width: 5px;
      }
      ::-webkit-scrollbar-track {
        background: #0B0C10;
      }
      ::-webkit-scrollbar-thumb {
        background: #252834;
        border-radius: 2px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #C5A880;
      }

      /* Editorial Hairline Accents */
      .gold-hairline {
        position: relative;
      }
      .gold-hairline::after {
        content: '';
        display: block;
        width: 48px;
        height: 1px;
        background: #C5A880;
        margin: 1.5rem auto 0;
        opacity: 0.8;
      }

      .gold-hairline-left::after {
        content: '';
        display: block;
        width: 48px;
        height: 1px;
        background: #C5A880;
        margin: 1.25rem 0 0;
        opacity: 0.8;
      }

      /* Ghost Buttons & Interactive Hover States */
      .btn-haute {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 0.85rem 2rem;
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: #F5F5F0;
        background: transparent;
        border: 1px solid rgba(197, 168, 128, 0.45);
        transition: all 500ms cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
      }

      .btn-haute::before {
        content: '';
        position: absolute;
        inset: 0;
        background: #C5A880;
        transform: translateY(100%);
        transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 0;
      }

      .btn-haute:hover {
        border-color: #C5A880;
        color: #0B0C10;
      }

      .btn-haute:hover::before {
        transform: translateY(0);
      }

      .btn-haute > * {
        position: relative;
        z-index: 1;
      }

      .btn-haute-solid {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 0.85rem 2rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: #0B0C10;
        background: #C5A880;
        border: 1px solid #C5A880;
        transition: all 400ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .btn-haute-solid:hover {
        background: transparent;
        color: #C5A880;
      }

      /* Edge-to-Edge Image Hover Slow Zoom */
      .dish-image-frame {
        overflow: hidden;
      }
      .dish-image-frame img {
        transition: transform 1200ms cubic-bezier(0.16, 1, 0.3, 1), filter 600ms ease;
      }
      .dish-card:hover .dish-image-frame img {
        transform: scale(1.06);
        filter: brightness(1.06);
      }

      /* Subtle Vignette & Ambient Glow */
      .vignette-radial {
        background: radial-gradient(circle at center, rgba(11, 12, 16, 0.4) 0%, rgba(11, 12, 16, 0.85) 75%, #0B0C10 100%);
      }

      .gold-radial-glow {
        box-shadow: 0 0 50px -10px rgba(197, 168, 128, 0.12);
      }
    </style>
  </head>
  <body class="bg-[#0B0C10] text-[#F5F5F0] antialiased">
