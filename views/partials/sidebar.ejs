<!-- EDITORIAL SLIDE-OUT SIDEBAR & BACKDROP OVERLAY -->
<div id="sidebar-backdrop" onclick="closeHauteSidebar()" class="fixed inset-0 z-[80] bg-black/75 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-500 ease-out"></div>

<aside id="editorial-sidebar" class="fixed inset-y-0 right-0 z-[90] w-full max-w-md sm:max-w-lg bg-[#0E1017] border-l border-white/10 shadow-2xl transform translate-x-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] flex flex-col justify-between overflow-y-auto custom-scroll">
  
  <!-- Sidebar Header -->
  <div class="p-8 sm:p-10 border-b border-white/10 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="font-cinzel text-lg tracking-[0.25em] text-[#F5F5F0]">MURAKAMI</span>
      <span class="text-[9px] tracking-[0.25em] uppercase px-2 py-0.5 border border-gold/40 text-gold font-sans">Sidebar</span>
    </div>
    
    <button onclick="closeHauteSidebar()" class="w-10 h-10 rounded-full border border-white/10 text-sand hover:text-gold hover:border-gold/60 flex items-center justify-center transition-colors focus:outline-none">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>
  </div>

  <!-- Editorial Navigation Links -->
  <div class="p-8 sm:p-10 flex-1 flex flex-col justify-center space-y-6">
    <div class="space-y-1">
      <span class="text-[10px] uppercase tracking-[0.3em] text-gold font-sans block mb-2">Navigation Atelier</span>
      <nav class="flex flex-col space-y-4">
        <a href="/" onclick="closeHauteSidebar()" class="group flex items-baseline justify-between py-2 border-b border-white/5 hover:border-gold/40 transition-colors">
          <span class="font-serif text-2xl sm:text-3xl uppercase tracking-[0.08em] text-[#F5F5F0] group-hover:text-gold group-hover:translate-x-2 transition-all">01. The Concept</span>
          <span class="text-xs font-serif italic text-sand-muted group-hover:text-gold transition-colors">哲学</span>
        </a>

        <a href="#culinary-showcase" onclick="closeHauteSidebar()" class="group flex items-baseline justify-between py-2 border-b border-white/5 hover:border-gold/40 transition-colors">
          <span class="font-serif text-2xl sm:text-3xl uppercase tracking-[0.08em] text-[#F5F5F0] group-hover:text-gold group-hover:translate-x-2 transition-all">02. Omakase & Menu</span>
          <span class="text-xs font-serif italic text-sand-muted group-hover:text-gold transition-colors">厳選</span>
        </a>

        <a href="#chef-philosophy" onclick="closeHauteSidebar()" class="group flex items-baseline justify-between py-2 border-b border-white/5 hover:border-gold/40 transition-colors">
          <span class="font-serif text-2xl sm:text-3xl uppercase tracking-[0.08em] text-[#F5F5F0] group-hover:text-gold group-hover:translate-x-2 transition-all">03. Chef's Table</span>
          <span class="text-xs font-serif italic text-sand-muted group-hover:text-gold transition-colors">職人</span>
        </a>

        <a href="#omakase-sets" onclick="closeHauteSidebar()" class="group flex items-baseline justify-between py-2 border-b border-white/5 hover:border-gold/40 transition-colors">
          <span class="font-serif text-2xl sm:text-3xl uppercase tracking-[0.08em] text-[#F5F5F0] group-hover:text-gold group-hover:translate-x-2 transition-all">04. Tasting Sets</span>
          <span class="text-xs font-serif italic text-sand-muted group-hover:text-gold transition-colors">おまかせ</span>
        </a>

        <a href="#reservations" onclick="closeHauteSidebar()" class="group flex items-baseline justify-between py-2 border-b border-white/5 hover:border-gold/40 transition-colors">
          <span class="font-serif text-2xl sm:text-3xl uppercase tracking-[0.08em] text-[#F5F5F0] group-hover:text-gold group-hover:translate-x-2 transition-all">05. Reservations</span>
          <span class="text-xs font-serif italic text-sand-muted group-hover:text-gold transition-colors">予約</span>
        </a>

        <a href="/location" onclick="closeHauteSidebar()" class="group flex items-baseline justify-between py-2 border-b border-white/5 hover:border-gold/40 transition-colors">
          <span class="font-serif text-2xl sm:text-3xl uppercase tracking-[0.08em] text-[#F5F5F0] group-hover:text-gold group-hover:translate-x-2 transition-all">06. Ateliers</span>
          <span class="text-xs font-serif italic text-sand-muted group-hover:text-gold transition-colors">銀座</span>
        </a>
      </nav>
    </div>

    <!-- Quick Actions in Sidebar -->
    <div class="pt-6 border-t border-white/10 space-y-3">
      <button onclick="closeHauteSidebar(); toggleCartDrawer();" class="w-full flex items-center justify-between p-3.5 bg-[#14161F] border border-white/5 hover:border-gold/40 text-xs uppercase tracking-[0.2em] text-sand hover:text-gold transition-all">
        <span class="flex items-center gap-3">
          <i class="fa-solid fa-bag-shopping text-gold"></i>
          <span>Dining Bag</span>
        </span>
        <span class="text-gold font-bold text-[11px]" id="sidebar-bag-count">View Bag</span>
      </button>

      <% if (typeof user !== 'undefined' && user) { %>
        <div class="p-4 bg-[#14161F] border border-white/5 space-y-2">
          <span class="text-[10px] uppercase tracking-[0.2em] text-sand-muted block">Signed In As</span>
          <p class="font-serif text-sm text-sand truncate"><%= user.email %></p>
          <div class="flex items-center gap-3 pt-2 text-[11px] tracking-wider uppercase">
            <a href="/orders" class="text-gold hover:underline">Orders</a>
            <span class="text-white/20">·</span>
            <% if (['admin', 'manager', 'store_manager', 'cashier', 'staff'].includes(user.role)) { %>
              <a href="/admin/dashboard" class="text-gold hover:underline">Dashboard</a>
              <span class="text-white/20">·</span>
            <% } %>
            <a href="/logout" class="text-crimson hover:underline">Sign Out</a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="btn-haute-solid w-full text-center">
          <span>Sign In / Member Portal</span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Sidebar Footer Notes -->
  <div class="p-8 sm:p-10 border-t border-white/10 bg-[#0B0C10]/60 space-y-3">
    <div class="text-[10px] tracking-[0.24em] uppercase text-sand-muted flex justify-between">
      <span>Ginza Atelier · Tokyo</span>
      <span class="text-gold">Michelin 2026</span>
    </div>
    <p class="font-serif italic text-xs text-sand-muted/70 leading-relaxed">
      Table seatings strictly coordinated with seasonal fish auctions from Toyosu market.
    </p>
  </div>

</aside>

<script>
  function openHauteSidebar() {
    const sidebar = document.getElementById('editorial-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    if (!sidebar || !backdrop) return;

    backdrop.classList.remove('opacity-0', 'pointer-events-none');
    backdrop.classList.add('opacity-100', 'pointer-events-auto');

    sidebar.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeHauteSidebar() {
    const sidebar = document.getElementById('editorial-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    if (!sidebar || !backdrop) return;

    sidebar.classList.add('translate-x-full');

    backdrop.classList.remove('opacity-100', 'pointer-events-auto');
    backdrop.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  // Sync ESC key to close sidebar
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeHauteSidebar();
  });
</script>

