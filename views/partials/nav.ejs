<nav id="haute-nav" class="fixed top-0 inset-x-0 z-50 transition-all duration-500 bg-transparent border-b border-transparent">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16">
    <div class="flex items-center justify-between h-20 lg:h-24">

      <!-- LEFT: Brand Logo / Monogram -->
      <a href="<%= (typeof user !== 'undefined' && user.role === 'staff') ? '/staff/menu' : '/' %>" class="group flex items-center gap-3">
        <span class="font-cinzel text-xl lg:text-2xl font-semibold tracking-[0.25em] text-[#F5F5F0] transition-colors group-hover:text-gold">
