      </a>

      <!-- CENTER: Editorial Navigation Links -->
      <div class="hidden lg:flex items-center gap-8 xl:gap-11">
        <a href="/" class="nav-editorial-link text-xs uppercase tracking-[0.22em] text-[#F5F5F0]/80 hover:text-gold transition-colors duration-300 relative py-1">
          The Concept
        </a>
        <a href="#culinary-showcase" class="nav-editorial-link text-xs uppercase tracking-[0.22em] text-[#F5F5F0]/80 hover:text-gold transition-colors duration-300 relative py-1">
          Omakase & Menu
        </a>
        <a href="#chef-philosophy" class="nav-editorial-link text-xs uppercase tracking-[0.22em] text-[#F5F5F0]/80 hover:text-gold transition-colors duration-300 relative py-1">
          Chef's Table
        </a>
        <a href="#omakase-sets" class="nav-editorial-link text-xs uppercase tracking-[0.22em] text-[#F5F5F0]/80 hover:text-gold transition-colors duration-300 relative py-1">
          Tasting Sets
        </a>
        <a href="#reservations" class="nav-editorial-link text-xs uppercase tracking-[0.22em] text-[#F5F5F0]/80 hover:text-gold transition-colors duration-300 relative py-1">
