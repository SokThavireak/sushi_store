        </a>
        <a href="/location" class="nav-editorial-link text-xs uppercase tracking-[0.22em] text-[#F5F5F0]/80 hover:text-gold transition-colors duration-300 relative py-1">
          Ateliers
        </a>
      </div>

      <!-- RIGHT: Bag / Cart, Admin Portal & Mobile Toggle -->
      <div class="flex items-center gap-5 sm:gap-7">
        
        <!-- Cart / Bag Trigger -->
        <button onclick="toggleCartDrawer()" class="relative flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-sand hover:text-gold transition-colors group focus:outline-none">
          <span class="font-cinzel text-xs hidden sm:inline">Bag</span>
          <div class="relative w-8 h-8 rounded-full border border-white/10 group-hover:border-gold/50 flex items-center justify-center transition-colors">
            <i class="fa-solid fa-bag-shopping text-[13px] text-gold"></i>
            <span id="cart-item-count" class="absolute -top-1 -right-1 w-4 h-4 bg-gold text-[#0B0C10] font-bold text-[9px] rounded-full flex items-center justify-center">0</span>
          </div>
        </button>

        <!-- User / Staff Account -->
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (['manager', 'admin', 'store_manager', 'staff', 'cashier'].includes(user.role)) { %>
            <a href="/admin/dashboard" class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 border border-gold/40 text-[11px] uppercase tracking-[0.18em] text-gold hover:bg-gold hover:text-[#0B0C10] transition-colors rounded-none">
              <i class="fa-solid fa-compass text-[10px]"></i> Staff
            </a>
          <% } %>

          <!-- Profile Dropdown Trigger -->
          <div class="relative">
            <button onclick="toggleProfileDropdown()" class="w-8 h-8 rounded-full border border-white/15 text-sand hover:border-gold/60 hover:text-gold flex items-center justify-center transition-colors text-xs focus:outline-none">
              <i class="fa-regular fa-user"></i>
            </button>
            <div id="haute-profile-menu" class="hidden absolute right-0 mt-3 w-52 bg-[#12141A] border border-white/10 shadow-2xl py-2 z-50">
              <div class="px-4 py-2 border-b border-white/5 text-[11px] tracking-wider text-sand-muted">
                Signed in as <span class="text-sand font-semibold block truncate"><%= user.email %></span>
              </div>
              <a href="/orders" class="block px-4 py-2.5 text-xs tracking-wider text-sand hover:bg-white/5 hover:text-gold transition-colors">
