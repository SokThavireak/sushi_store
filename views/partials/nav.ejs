              <a href="/logout" class="block px-4 py-2.5 text-xs tracking-wider text-crimson hover:bg-crimson/10 transition-colors border-t border-white/5">
                <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i> Sign Out
              </a>
            </div>
          </div>
        <% } else { %>
          <a href="/login" class="text-xs uppercase tracking-[0.22em] text-gold hover:text-white transition-colors">
            Sign In
          </a>
        <% } %>

        <!-- Sidebar Trigger Button (Desktop & Mobile) -->
        <button onclick="openHauteSidebar()" title="Open Atelier Sidebar" class="flex items-center gap-2 px-3 py-1.5 border border-gold/40 text-xs uppercase tracking-[0.22em] text-gold hover:bg-gold hover:text-[#0B0C10] transition-all group focus:outline-none">
          <div class="flex flex-col gap-1 items-end w-4">
            <span class="w-4 h-[1px] bg-gold group-hover:bg-[#0B0C10] transition-colors"></span>
            <span class="w-2.5 h-[1px] bg-gold group-hover:bg-[#0B0C10] transition-colors"></span>
            <span class="w-3.5 h-[1px] bg-gold group-hover:bg-[#0B0C10] transition-colors"></span>
          </div>
          <span class="font-cinzel text-[11px] hidden sm:inline">Menu</span>
        </button>

      </div>

    </div>
  </div>
</nav>

<!-- FULL-SCREEN MATTE-BLACK MOBILE OVERLAY DRAWER -->
<div id="haute-drawer" class="fixed inset-0 z-[60] bg-[#0B0C10]/98 backdrop-blur-2xl transform translate-x-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] flex flex-col justify-between p-8 sm:p-12">
  <div class="flex items-center justify-between border-b border-white/10 pb-6">
    <span class="font-cinzel text-lg tracking-[0.3em] text-gold">MURAKAMI ATELIER</span>
    <button onclick="toggleHauteDrawer()" class="w-10 h-10 border border-white/10 rounded-full flex items-center justify-center text-sand hover:text-gold hover:border-gold transition-colors">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>
  </div>

  <div class="flex flex-col gap-6 py-10">
    <a href="/" onclick="toggleHauteDrawer()" class="font-serif text-3xl sm:text-4xl tracking-wider text-[#F5F5F0] hover:text-gold hover:translate-x-2 transition-all">
      01. The Concept
    </a>
    <a href="#culinary-showcase" onclick="toggleHauteDrawer()" class="font-serif text-3xl sm:text-4xl tracking-wider text-[#F5F5F0] hover:text-gold hover:translate-x-2 transition-all">
      02. Omakase & Menu
    </a>
    <a href="#chef-philosophy" onclick="toggleHauteDrawer()" class="font-serif text-3xl sm:text-4xl tracking-wider text-[#F5F5F0] hover:text-gold hover:translate-x-2 transition-all">
      03. Chef's Table
    </a>
    <a href="#omakase-sets" onclick="toggleHauteDrawer()" class="font-serif text-3xl sm:text-4xl tracking-wider text-[#F5F5F0] hover:text-gold hover:translate-x-2 transition-all">
      04. Tasting Sets
    </a>
    <a href="#reservations" onclick="toggleHauteDrawer()" class="font-serif text-3xl sm:text-4xl tracking-wider text-[#F5F5F0] hover:text-gold hover:translate-x-2 transition-all">
      05. Reservations
    </a>
    <a href="/location" class="font-serif text-3xl sm:text-4xl tracking-wider text-[#F5F5F0] hover:text-gold hover:translate-x-2 transition-all">
      06. Locations
    </a>
  </div>

  <div class="border-t border-white/10 pt-6 flex flex-col gap-3 text-xs tracking-[0.2em] uppercase text-sand-muted">
    <p>GINZA DISTRICT · TOKYO, JAPAN</p>
    <p>TABLE SERVICE BY RESERVATION ONLY</p>
  </div>
</div>

<script>
  // Sticky Blur Header Transition
  const hauteNav = document.getElementById('haute-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      hauteNav.classList.add('bg-[#0B0C10]/85', 'backdrop-blur-md', 'border-white/10');
      hauteNav.classList.remove('bg-transparent', 'border-transparent');
    } else {
      hauteNav.classList.remove('bg-[#0B0C10]/85', 'backdrop-blur-md', 'border-white/10');
      hauteNav.classList.add('bg-transparent', 'border-transparent');
    }
  });

  function toggleHauteDrawer() {
    const drawer = document.getElementById('haute-drawer');
    drawer.classList.toggle('translate-x-full');
  }

  function toggleProfileDropdown() {
    const menu = document.getElementById('haute-profile-menu');
    if (menu) menu.classList.toggle('hidden');
  }
</script>
