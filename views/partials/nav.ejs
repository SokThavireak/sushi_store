              </a>
              <% if (user.role === 'user') { %>
              <a href="/profile" class="block px-4 py-2.5 text-xs tracking-wider text-sand hover:bg-white/5 hover:text-gold transition-colors">
                <i class="fa-solid fa-sliders mr-2 text-gold/70"></i> Settings
              </a>
