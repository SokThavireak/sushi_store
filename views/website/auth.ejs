<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Member Portal · Murakami Atelier</title>

    <!-- Google Fonts: Cormorant Garamond & Cinzel & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              canvas: {
                DEFAULT: "#0B0C10",
                card: "#12141A",
                surface: "#181A22",
                elevated: "#1E212B",
              },
              gold: {
                DEFAULT: "#C5A880",
                light: "#E3CCA8",
                dark: "#8C714E",
              },
              sand: {
                DEFAULT: "#F5F5F0",
                muted: "#9E9EA7",
              },
              crimson: {
                DEFAULT: "#8B2635",
              }
            },
            fontFamily: {
              serif: ['"Cormorant Garamond"', 'serif'],
              cinzel: ['"Cinzel"', 'serif'],
              sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            }
          }
        }
      };
    </script>

    <style>
      body {
        background-color: #0B0C10;
        color: #F5F5F0;
        font-family: "Plus Jakarta Sans", sans-serif;
      }

      /* Container Slide Transitions */
      .auth-card-wrap {
        position: relative;
        overflow: hidden;
        width: 860px;
        max-width: 100%;
        min-height: 560px;
      }

      .form-container {
        position: absolute;
        top: 0;
        height: 100%;
        transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .sign-in-container {
        left: 0;
        width: 50%;
        z-index: 2;
      }

      .sign-up-container {
        left: 0;
        width: 50%;
        opacity: 0;
        z-index: 1;
      }

      .auth-card-wrap.right-panel-active .sign-in-container {
        transform: translateX(100%);
      }

      .auth-card-wrap.right-panel-active .sign-up-container {
        transform: translateX(100%);
        opacity: 1;
        z-index: 5;
        animation: show 0.6s;
      }

      @keyframes show {
        0%, 49.99% { opacity: 0; z-index: 1; }
        50%, 100% { opacity: 1; z-index: 5; }
      }

      .overlay-container {
        position: absolute;
        top: 0;
        left: 50%;
        width: 50%;
        height: 100%;
        overflow: hidden;
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 100;
      }

      .auth-card-wrap.right-panel-active .overlay-container {
        transform: translateX(-100%);
      }

      .overlay {
        background: #141720;
        color: #F5F5F0;
        position: relative;
        left: -100%;
        height: 100%;
        width: 200%;
        transform: translateX(0);
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .auth-card-wrap.right-panel-active .overlay {
        transform: translateX(50%);
      }

      .overlay-panel {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 0 44px;
        text-align: center;
        top: 0;
        height: 100%;
        width: 50%;
        transform: translateX(0);
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .overlay-left {
        transform: translateX(-20%);
      }

      .auth-card-wrap.right-panel-active .overlay-left {
        transform: translateX(0);
      }

      .overlay-right {
        right: 0;
        transform: translateX(0);
      }

      .auth-card-wrap.right-panel-active .overlay-right {
        transform: translateX(20%);
      }

      /* Mobile 3D Book Flip Responsive */
      @media (max-width: 768px) {
        .auth-card-wrap {
          width: 100%;
          max-width: 420px;
          min-height: 560px;
          perspective: 1200px;
        }

        .overlay-container {
          display: none;
        }

        .form-container {
          width: 100%;
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          padding: 0;
          backface-visibility: hidden;
          transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
        }

        .sign-in-container {
          transform: rotateY(0deg);
          z-index: 5;
          opacity: 1;
          pointer-events: all;
        }

        .sign-up-container {
          transform: rotateY(180deg);
          z-index: 1;
          opacity: 0;
          pointer-events: none;
        }

        .auth-card-wrap.right-panel-active .sign-in-container {
          transform: rotateY(-180deg);
          z-index: 1;
          opacity: 0;
          pointer-events: none;
        }

        .auth-card-wrap.right-panel-active .sign-up-container {
          transform: rotateY(0deg);
          z-index: 5;
          opacity: 1;
          pointer-events: all;
        }

        .mobile-toggle {
          display: block !important;
        }
      }

      .mobile-toggle {
        display: none;
      }
    </style>
</head>

<body class="bg-[#0B0C10] flex flex-col justify-center items-center min-h-screen p-4 sm:p-6 relative overflow-hidden select-none">
    
    <!-- Background Vignette & Ambient Glow -->
    <div class="absolute inset-0 bg-radial pointer-events-none opacity-60"></div>
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-gold/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-gold/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Return to Website Home Link -->
    <a href="/" class="absolute top-6 left-6 sm:top-8 sm:left-10 z-30 inline-flex items-center gap-2 text-xs uppercase tracking-[0.24em] text-sand-muted hover:text-gold transition-colors font-sans">
      <i class="fa-solid fa-arrow-left text-[10px]"></i>
      <span>Return to Atelier</span>
    </a>

    <!-- Top Monogram -->
    <div class="text-center mb-8 z-10">
      <span class="font-cinzel text-xl sm:text-2xl tracking-[0.3em] text-[#F5F5F0] block">
        MURAKAMI
      </span>
      <span class="text-[10px] uppercase tracking-[0.3em] text-gold font-sans block mt-1">
        Private Guest & Staff Portal · 会員入口
      </span>
    </div>

    <!-- TOAST NOTIFICATION CONTAINER -->
    <div id="toast-container" class="fixed top-8 right-6 z-[120] flex flex-col gap-3 pointer-events-none"></div>

    <!-- AUTHENTICATION CARD WRAPPER -->
    <div class="auth-card-wrap bg-[#12141A] border border-white/10 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] relative z-20" id="container">

        <!-- 1. SIGN UP (REGISTER) FORM -->
        <div class="form-container sign-up-container">
            <form onsubmit="handleAuth(event, '/register')" class="bg-[#12141A] flex flex-col items-center justify-center h-full px-8 sm:px-12 text-center text-sand">
                <span class="text-[10px] uppercase tracking-[0.28em] text-gold font-sans block mb-1">Privilege Access</span>
                <h2 class="font-serif text-3xl uppercase tracking-[0.08em] text-white mb-2">Create Account</h2>
                <p class="font-serif italic text-sand-muted text-xs mb-6">Join our private dining registry for bespoke allocations.</p>

                <!-- Google OAuth -->
                <a href="/auth/google" class="border border-white/10 w-full py-2.5 mb-4 flex justify-center items-center gap-3 text-xs uppercase tracking-[0.18em] text-sand hover:border-gold/60 hover:text-gold transition-colors bg-white/5">
                    <i class="fab fa-google text-xs text-gold"></i>
                    <span>Register with Google</span>
                </a>

                <div class="flex items-center gap-3 w-full my-3">
                  <span class="flex-1 h-[1px] bg-white/10"></span>
                  <span class="text-[10px] uppercase tracking-[0.2em] text-sand-muted">or register credentials</span>
                  <span class="flex-1 h-[1px] bg-white/10"></span>
                </div>

                <div class="w-full space-y-3 mb-6">
                  <input type="email" name="username" placeholder="EMAIL ADDRESS" required
                      class="bg-[#181A22] border border-white/10 px-4 py-3 w-full text-xs tracking-[0.16em] uppercase text-sand focus:outline-none focus:border-gold transition-colors placeholder:text-sand-muted/50" />
                  <input type="password" name="password" placeholder="PASSWORD (MIN 6 CHARS)" required
                      class="bg-[#181A22] border border-white/10 px-4 py-3 w-full text-xs tracking-[0.16em] uppercase text-sand focus:outline-none focus:border-gold transition-colors placeholder:text-sand-muted/50" />
                </div>

                <button type="submit" class="w-full py-3.5 bg-gold text-[#0B0C10] text-xs font-semibold uppercase tracking-[0.22em] border border-gold hover:bg-transparent hover:text-gold transition-all duration-300">
                    Register Privilege
                </button>

                <p class="mobile-toggle text-xs text-sand-muted tracking-wider mt-6">
                    Already a member? <button type="button" id="mobileSignIn" class="text-gold uppercase tracking-widest font-semibold ml-1">Sign In</button>
                </p>
            </form>
        </div>

        <!-- 2. SIGN IN (LOGIN) FORM -->
        <div class="form-container sign-in-container">
            <form onsubmit="handleAuth(event, '/login')" class="bg-[#12141A] flex flex-col items-center justify-center h-full px-8 sm:px-12 text-center text-sand">
                <span class="text-[10px] uppercase tracking-[0.28em] text-gold font-sans block mb-1">Maison Murakami</span>
                <h2 class="font-serif text-3xl uppercase tracking-[0.08em] text-white mb-2">Member Sign In</h2>
                <p class="font-serif italic text-sand-muted text-xs mb-6">Enter your guest or staff credentials.</p>

                <!-- Google OAuth -->
                <a href="/auth/google" class="border border-white/10 w-full py-2.5 mb-4 flex justify-center items-center gap-3 text-xs uppercase tracking-[0.18em] text-sand hover:border-gold/60 hover:text-gold transition-colors bg-white/5">
                    <i class="fab fa-google text-xs text-gold"></i>
                    <span>Sign In with Google</span>
                </a>

                <div class="flex items-center gap-3 w-full my-3">
                  <span class="flex-1 h-[1px] bg-white/10"></span>
                  <span class="text-[10px] uppercase tracking-[0.2em] text-sand-muted">or continue with email</span>
                  <span class="flex-1 h-[1px] bg-white/10"></span>
                </div>

                <div class="w-full space-y-3 mb-4">
                  <input type="email" name="username" placeholder="EMAIL ADDRESS" required
                      class="bg-[#181A22] border border-white/10 px-4 py-3 w-full text-xs tracking-[0.16em] uppercase text-sand focus:outline-none focus:border-gold transition-colors placeholder:text-sand-muted/50" />
                  <input type="password" name="password" placeholder="PASSWORD" required
                      class="bg-[#181A22] border border-white/10 px-4 py-3 w-full text-xs tracking-[0.16em] uppercase text-sand focus:outline-none focus:border-gold transition-colors placeholder:text-sand-muted/50" />
                </div>

                <a href="#" onclick="showNotification('Please contact the concierge desk at concierge@murakamisushi.com to reset your credentials.', 'info')" class="text-[10px] uppercase tracking-[0.2em] text-sand-muted hover:text-gold transition-colors mb-6 self-end">
                  Forgot Password?
                </a>

                <button type="submit" class="w-full py-3.5 bg-gold text-[#0B0C10] text-xs font-semibold uppercase tracking-[0.22em] border border-gold hover:bg-transparent hover:text-gold transition-all duration-300">
                    Authenticate
                </button>

                <p class="mobile-toggle text-xs text-sand-muted tracking-wider mt-6">
                    New guest? <button type="button" id="mobileSignUp" class="text-gold uppercase tracking-widest font-semibold ml-1">Create Account</button>
                </p>
            </form>
        </div>

        <!-- 3. SLIDING OVERLAY (DESKTOP) -->
        <div class="overlay-container">
            <div class="overlay">
                <!-- Left Overlay Panel (shows when right panel active) -->
                <div class="overlay-panel overlay-left bg-[#181A22] border-r border-white/10">
                    <span class="text-[10px] uppercase tracking-[0.3em] text-gold font-sans block mb-2">Welcome Back</span>
                    <h3 class="font-serif text-3xl uppercase tracking-[0.1em] text-white mb-4">Already Registered?</h3>
                    <p class="font-serif italic text-sand-muted text-sm leading-relaxed mb-8 max-w-xs">
                        Access your table reservations, order archives, and private cellar selections.
                    </p>
                    <button id="signIn" class="px-8 py-3 border border-gold/60 text-gold text-xs uppercase tracking-[0.22em] hover:bg-gold hover:text-[#0B0C10] transition-colors">
                        Sign In Instead
                    </button>
                </div>

                <!-- Right Overlay Panel (shows by default) -->
                <div class="overlay-panel overlay-right bg-[#181A22] border-l border-white/10">
                    <span class="text-[10px] uppercase tracking-[0.3em] text-gold font-sans block mb-2">Exclusive Lineage</span>
                    <h3 class="font-serif text-3xl uppercase tracking-[0.1em] text-white mb-4">A New Guest?</h3>
                    <p class="font-serif italic text-sand-muted text-sm leading-relaxed mb-8 max-w-xs">
                        Create an account to track your orders, book omakase counters, and receive seasonal releases.
                    </p>
                    <button id="signUp" class="px-8 py-3 border border-gold/60 text-gold text-xs uppercase tracking-[0.22em] hover:bg-gold hover:text-[#0B0C10] transition-colors">
                        Create Account
                    </button>
                </div>
            </div>
        </div>

    </div>

    <!-- SCRIPT LOGIC -->
    <script>
        const signUpButton = document.getElementById('signUp');
        const signInButton = document.getElementById('signIn');
        const mobileSignUp = document.getElementById('mobileSignUp');
        const mobileSignIn = document.getElementById('mobileSignIn');
        const container = document.getElementById('container');

        function activateSignUp() { container.classList.add("right-panel-active"); }
        function activateSignIn() { container.classList.remove("right-panel-active"); }

        if (signUpButton) signUpButton.addEventListener('click', activateSignUp);
        if (signInButton) signInButton.addEventListener('click', activateSignIn);
        if (mobileSignUp) mobileSignUp.addEventListener('click', activateSignUp);
        if (mobileSignIn) mobileSignIn.addEventListener('click', activateSignIn);

        // NOTIFICATION TOAST
        function showNotification(message, type = 'success') {
            const toastContainer = document.getElementById('toast-container');
            const toast = document.createElement('div');

            let bgClass, icon;
            if (type === 'error') {
                bgClass = 'bg-[#8B2635] border border-white/20';
                icon = '<i class="fa-solid fa-circle-exclamation text-white"></i>';
            } else if (type === 'info') {
                bgClass = 'bg-[#181A22] border border-gold/50';
                icon = '<i class="fa-solid fa-circle-info text-gold"></i>';
            } else {
                bgClass = 'bg-[#12141A] border border-gold/60';
                icon = '<i class="fa-solid fa-circle-check text-gold"></i>';
            }

            toast.className = `${bgClass} text-[#F5F5F0] px-6 py-4 shadow-2xl flex items-center gap-3 transform translate-x-full transition-all duration-500 opacity-0 min-w-[320px] pointer-events-auto backdrop-blur-md`;
            toast.innerHTML = `
                <div class="text-base">${icon}</div>
                <div class="flex flex-col">
                    <span class="font-sans text-[10px] uppercase tracking-[0.2em] text-sand-muted">${type}</span>
                    <span class="font-sans text-xs tracking-wider text-sand">${message}</span>
                </div>
            `;

            toastContainer.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-x-full', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('translate-x-full', 'opacity-0');
                setTimeout(() => toast.remove(), 500);
            }, 3500);
        }

        // AUTH HANDLER
        async function handleAuth(event, endpoint) {
            event.preventDefault();

            const form = event.target;
            const btn = form.querySelector('button[type="submit"]');
            const originalText = btn.innerText;

            btn.innerText = "AUTHENTICATING...";
            btn.disabled = true;
            btn.classList.add('opacity-70', 'cursor-not-allowed');

            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json().catch(() => ({}));

                if (response.ok) {
                    showNotification(result.message || 'Authentication Successful.', 'success');

                    let targetUrl = result.targetUrl;
                    if (!targetUrl) {
                        const role = result.role || (result.user && result.user.role);
                        if (['admin', 'manager', 'store_manager', 'cashier'].includes(role)) {
                            targetUrl = '/admin/dashboard';
                        } else if (role === 'staff') {
                            targetUrl = '/staff/menu';
                        } else {
                            targetUrl = '/';
                        }
                    }

                    setTimeout(() => {
                        window.location.href = targetUrl;
                    }, 1000);
                } else {
                    showNotification(result.error || 'Authentication Failed', 'error');
                    btn.innerText = originalText;
                    btn.disabled = false;
                    btn.classList.remove('opacity-70', 'cursor-not-allowed');
                }
            } catch (err) {
                showNotification('Network connection error', 'error');
                btn.innerText = originalText;
                btn.disabled = false;
                btn.classList.remove('opacity-70', 'cursor-not-allowed');
            }
        }
    </script>
</body>

</html>
