<!-- LOCATIONS PAGE: HAUTE CUISINE MICHELIN EDITORIAL STYLING -->
<div class="pt-32 pb-24 bg-[#0B0C10] min-h-screen text-sand">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16">
    
    <!-- Editorial Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <span class="text-[10px] sm:text-xs uppercase tracking-[0.3em] text-gold font-sans block mb-3">
        Sanctuaries & Ateliers · 店舗情報
      </span>
      <h1 class="font-serif text-4xl sm:text-6xl uppercase tracking-[0.12em] text-[#F5F5F0] font-light gold-hairline">
        Our Dining Ateliers
      </h1>
      <p class="font-serif italic text-sand-muted text-base sm:text-lg mt-8 leading-relaxed">
        Intimate dining counters crafted from 300-year-old Yoshino cypress wood. Reservations honored daily.
      </p>
    </div>

    <!-- Atelier Locations Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if (typeof locations !== 'undefined' && locations.length > 0) { %>
        <% locations.forEach((loc, index) => { %>
          <div class="bg-[#12141A] border border-white/5 hover:border-gold/40 transition-all duration-500 p-8 sm:p-10 flex flex-col justify-between">
            <div class="space-y-6">
              
              <!-- Location Header & Open/Closed Status -->
              <div class="flex items-center justify-between border-b border-white/5 pb-4">
                <span class="text-[10px] tracking-[0.25em] text-gold uppercase font-sans">
                  Atelier <%= index + 1 %>
                </span>
                <% if (loc.status === 'Open') { %>
                  <span class="inline-flex items-center gap-2 text-[10px] font-sans tracking-[0.2em] text-emerald-400 uppercase bg-emerald-950/40 border border-emerald-800/40 px-2.5 py-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Service Active
                  </span>
                <% } else { %>
                  <span class="text-[10px] font-sans tracking-[0.2em] text-sand-muted uppercase bg-white/5 border border-white/10 px-2.5 py-0.5">
                    Resting
                  </span>
                <% } %>
              </div>

              <!-- Name & Address -->
              <div class="space-y-3">
                <h2 class="font-serif text-2xl uppercase tracking-[0.08em] text-white">
                  <%= loc.name %>
                </h2>
                <p class="font-serif italic text-sand-muted text-sm leading-relaxed">
                  <%= loc.address || 'Tokyo Ginza District, Chuo-ku, Honshu, Japan' %>
                </p>
              </div>

              <!-- Details & Timings -->
              <div class="space-y-2 pt-2 text-xs font-sans tracking-[0.15em] text-sand-muted">
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-clock text-gold/70 text-[11px]"></i>
                  <span>Lunch: 12:00–15:00 · Dinner: 18:00–23:00</span>
                </div>
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-chair text-gold/70 text-[11px]"></i>
                  <span>Counter Seating: 12 Guests Maximum</span>
                </div>
              </div>

            </div>

            <!-- Booking / Directions Trigger -->
            <div class="pt-8 border-t border-white/5 mt-8 flex items-center justify-between">
              <a 
                href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(loc.name + ' ' + (loc.address || '')) %>" 
                target="_blank"
                class="text-[11px] uppercase tracking-[0.2em] text-sand hover:text-gold transition-colors flex items-center gap-2"
              >
                <i class="fa-solid fa-location-dot text-gold text-[10px]"></i>
                <span>Google Map</span>
              </a>

              <a href="/#reservations" class="btn-haute py-2 px-4 text-[10px]">
                <span>Reserve</span>
              </a>
            </div>

          </div>
        <% }) %>
      <% } else { %>
        <!-- Default Ginza Atelier Fallback if no DB rows -->
        <div class="col-span-full max-w-xl mx-auto bg-[#12141A] border border-white/10 p-10 text-center space-y-6">
          <span class="text-[10px] uppercase tracking-[0.25em] text-gold font-sans block">Primary Sanctuary</span>
          <h2 class="font-serif text-3xl uppercase tracking-[0.1em] text-white">Ginza Atelier · Tokyo</h2>
          <p class="font-serif italic text-sand-muted text-sm">Ginza 6-Chome, Chuo City, Tokyo, Japan</p>
          <a href="/#reservations" class="btn-haute-solid inline-block">
            <span>Book Table Experience</span>
          </a>
        </div>
      <% } %>
    </div>

  </div>
</div>
