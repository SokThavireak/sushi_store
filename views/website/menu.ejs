<!-- MENU PAGE: HAUTE CUISINE MICHELIN STYLING -->
<div class="pt-32 pb-24 bg-[#0B0C10] min-h-screen text-sand">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16">
    
    <!-- Editorial Page Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <span class="text-[10px] sm:text-xs uppercase tracking-[0.3em] text-gold font-sans block mb-3">
        La Carte & Dégustation · お品書き
      </span>
      <h1 class="font-serif text-4xl sm:text-6xl uppercase tracking-[0.12em] text-[#F5F5F0] font-light gold-hairline">
        The Culinary Menu
      </h1>
      <p class="font-serif italic text-sand-muted text-base sm:text-lg mt-8 leading-relaxed">
        Pristine oceanic harvest seasoned with 10-year aged nikiri soy, fresh grated wasabi, and hand-pressed akasu sushi-meshi.
      </p>
    </div>

    <!-- Category Filter Tabs with Active Gold Dot Indicator -->
    <div class="sticky top-20 z-30 bg-[#0B0C10]/90 backdrop-blur-md py-4 border-b border-white/10 mb-14">
      <div class="flex items-center justify-start sm:justify-center gap-3 sm:gap-6 overflow-x-auto pb-2 scrollbar-none">
        <button 
          onclick="filterMenuCategory('all', this)"
          class="menu-cat-btn px-4 py-2 text-xs uppercase tracking-[0.24em] transition-all flex items-center gap-2 text-gold font-semibold shrink-0"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-gold cat-indicator"></span>
          <span>All Courses</span>
        </button>

        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
          <% categories.forEach(cat => { %>
            <button 
              onclick="filterMenuCategory('<%= cat.name.toLowerCase() %>', this)"
              class="menu-cat-btn px-4 py-2 text-xs uppercase tracking-[0.24em] text-sand-muted hover:text-sand transition-all flex items-center gap-2 shrink-0"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-transparent cat-indicator"></span>
              <span><%= cat.name %></span>
            </button>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Menu Grid Grouped by Categories -->
    <div id="full-menu-container" class="space-y-20">
      <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
        <% categories.forEach(category => { %>
          <% 
            const categoryProducts = category.name === 'Most Sales' 
              ? products.filter(p => p.is_best_seller) 
              : products.filter(p => p.category === category.name);
          %>
          <% if (categoryProducts.length > 0) { %>
            <div class="menu-category-block" data-category="<%= category.name.toLowerCase() %>">
              
              <!-- Category Title -->
              <div class="flex items-baseline justify-between border-b border-white/10 pb-4 mb-10">
                <div class="flex items-baseline gap-4">
                  <h2 class="font-serif text-2xl sm:text-3xl uppercase tracking-[0.1em] text-white">
                    <%= category.name === 'Most Sales' ? 'Signature Hits' : category.name %>
                  </h2>
                  <span class="text-xs font-serif italic text-gold/70">
                    <%= categoryProducts.length %> creations
                  </span>
                </div>
                <span class="text-[10px] tracking-[0.25em] text-sand-muted uppercase font-sans hidden sm:inline">
                  Atelier Sourcing
                </span>
              </div>

              <!-- Dish Cards Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                <% categoryProducts.forEach(product => { %>
                  <div 
                    class="dish-card group relative bg-[#12141A] border border-white/5 hover:border-gold/40 transition-all duration-700 flex flex-col justify-between"
                    data-dish-id="<%= product.id %>"
                    data-dish-name="<%= product.name %>"
                    data-dish-price="<%= parseFloat(product.price).toFixed(2) %>"
                    data-dish-category="<%= product.category || category.name %>"
                    data-dish-image="<%= product.image_url || 'https://images.unsplash.com/photo-1579584425555-c3ce17fd4351?q=80&w=800' %>"
                    data-dish-desc="<%= product.description || 'Pristine ocean fish, seasoned sushi-meshi, brushed with master nikiri soy & yuzu essence.' %>"
                  >
                    <!-- Dish Image Frame -->
                    <div class="dish-image-frame relative aspect-[4/3] w-full overflow-hidden bg-black/60">
                      <img 
                        src="<%= product.image_url || 'https://images.unsplash.com/photo-1579584425555-c3ce17fd4351?q=80&w=800' %>" 
                        alt="<%= product.name %>"
                        loading="lazy"
                        class="w-full h-full object-cover"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-[#12141A] via-transparent to-black/30"></div>

                      <% if (product.is_best_seller) { %>
                        <span class="absolute top-4 left-4 text-[10px] font-sans tracking-[0.2em] text-gold uppercase bg-gold/15 px-2.5 py-1 backdrop-blur-md border border-gold/40">
                          Signature
                        </span>
                      <% } %>
                    </div>

                    <!-- Dish Info & Pricing -->
                    <div class="p-6 sm:p-8 flex flex-col flex-1 justify-between gap-6">
                      <div class="space-y-3">
                        <div class="flex items-baseline justify-between gap-4">
                          <h3 class="font-serif text-xl sm:text-2xl tracking-[0.05em] uppercase text-[#F5F5F0] group-hover:text-gold transition-colors">
                            <%= product.name %>
                          </h3>
                          <span class="font-serif text-xl text-gold font-light shrink-0">
                            $<%= parseFloat(product.price).toFixed(2) %>
                          </span>
                        </div>

                        <p class="font-serif italic text-sand-muted text-sm leading-relaxed line-clamp-2">
                          <%= product.description || 'Pristine seasonal catch, hand-pressed red vinegar rice, nikiri reduction.' %>
                        </p>
                      </div>

                      <!-- Action Button -->
                      <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                        <span class="text-[10px] tracking-[0.2em] uppercase text-sand-muted font-sans">
                          Portion Servie
                        </span>

                        <button 
                          onclick="quickAddToBag(this)"
                          title="Add to Dining Bag"
                          class="px-4 py-2 border border-white/10 hover:border-gold hover:bg-gold hover:text-[#0B0C10] text-gold transition-all text-xs uppercase tracking-[0.18em] flex items-center gap-2"
                        >
                          <i class="fa-solid fa-plus text-[10px]"></i>
                          <span>Order</span>
                        </button>
                      </div>
                    </div>

                  </div>
                <% }) %>
              </div>

            </div>
          <% } %>
        <% }) %>
      <% } else { %>
        <div class="py-20 text-center text-sand-muted font-serif text-xl">
          The seasonal carte is currently being prepared by our master chef.
        </div>
      <% } %>
    </div>

  </div>
</div>

<script>
  function filterMenuCategory(cat, element) {
    const buttons = document.querySelectorAll('.menu-cat-btn');
    buttons.forEach(btn => {
      btn.classList.remove('text-gold', 'font-semibold');
      btn.classList.add('text-sand-muted');
      const dot = btn.querySelector('.cat-indicator');
      if (dot) dot.classList.replace('bg-gold', 'bg-transparent');
    });

    element.classList.add('text-gold', 'font-semibold');
    element.classList.remove('text-sand-muted');
    const dot = element.querySelector('.cat-indicator');
    if (dot) dot.classList.replace('bg-transparent', 'bg-gold');

    const blocks = document.querySelectorAll('.menu-category-block');
    blocks.forEach(block => {
      const blockCat = block.getAttribute('data-category');
      if (cat === 'all' || blockCat === cat) {
        block.style.display = 'block';
      } else {
        block.style.display = 'none';
      }
    });
  }

  async function quickAddToBag(btn) {
    const card = btn.closest('.dish-card');
    if (!card) return;
    const productId = card.getAttribute('data-dish-id');
    const name = card.getAttribute('data-dish-name');

    try {
      const res = await fetch('/api/cart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId: productId })
      });
      if (res.status === 401) {
        showToast('Please sign in to add dishes to your bag.', 'error');
        setTimeout(() => window.location.href = '/login', 1500);
        return;
      }
      const data = await res.json();
      if (res.ok) {
        showToast(`${name} added to your dining bag.`, 'success');
        updateBagBadge();
      } else {
        showToast(data.error || 'Unable to add dish', 'error');
      }
    } catch (err) {
      showToast('Network error adding to bag', 'error');
    }
  }

  async function updateBagBadge() {
    try {
      const res = await fetch('/api/cart');
      if (res.ok) {
        const items = await res.json();
        const countBadge = document.getElementById('cart-item-count');
        if (countBadge) {
          const totalCount = items.reduce((sum, item) => sum + (item.quantity || 1), 0);
          countBadge.textContent = totalCount;
        }
      }
    } catch (err) {}
  }
  document.addEventListener('DOMContentLoaded', updateBagBadge);
</script>
