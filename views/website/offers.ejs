<!-- OFFERS PAGE: HAUTE CUISINE MICHELIN EDITORIAL STYLING -->
<div class="pt-32 pb-24 bg-[#0B0C10] min-h-screen text-sand">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16">
    
    <!-- Editorial Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <span class="text-[10px] sm:text-xs uppercase tracking-[0.3em] text-gold font-sans block mb-3">
        Seasonal Privilege · 季節の特選
      </span>
      <h1 class="font-serif text-4xl sm:text-6xl uppercase tracking-[0.12em] text-[#F5F5F0] font-light gold-hairline">
        Exclusive Seasonal Flights
      </h1>
      <p class="font-serif italic text-sand-muted text-base sm:text-lg mt-8 leading-relaxed">
        Curated tasting boxes and chef's pairings offered in limited daily batches for our culinary connoisseurs.
      </p>
    </div>

    <!-- Editorial Featured Banner Card -->
    <div class="relative w-full aspect-[21/9] min-h-[300px] max-h-[460px] overflow-hidden border border-white/10 mb-16 shadow-2xl bg-[#12141A]">
      <img 
        src="https://images.unsplash.com/photo-1579871494447-9811cf80d66c?q=80&w=2070&auto=format&fit=crop" 
        alt="Seasonal Omakase Box" 
        class="w-full h-full object-cover brightness-75 hover:scale-105 transition-transform duration-1000"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B0C10] via-black/40 to-transparent"></div>
      
      <div class="absolute bottom-6 left-6 sm:bottom-12 sm:left-12 max-w-xl space-y-3">
        <span class="text-[10px] uppercase tracking-[0.25em] text-gold font-sans block">
          Seasonal Privilege · 15% Reduction
        </span>
        <h2 class="font-serif text-2xl sm:text-4xl uppercase tracking-[0.08em] text-white">
          The Autumn Truffle & Otoro Flight
        </h2>
        <p class="font-serif italic text-sand-muted text-sm sm:text-base hidden sm:block">
          Hand-torched bluefin belly with Perigord black truffle butter and 25-year aged balsamic nikiri glaze.
        </p>
      </div>
    </div>

    <!-- Discounted / Promotional Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if (typeof products !== 'undefined' && products.length > 0) { %>
        <% products.forEach(product => { %>
          <div 
            class="dish-card group relative bg-[#12141A] border border-white/5 hover:border-gold/40 transition-all duration-700 flex flex-col justify-between"
            data-dish-id="<%= product.id %>"
            data-dish-name="<%= product.name %>"
            data-dish-price="<%= parseFloat(product.price).toFixed(2) %>"
          >
            <!-- Dish Image -->
            <div class="dish-image-frame relative aspect-[4/3] w-full overflow-hidden bg-black/60">
              <img 
                src="<%= product.image_url || 'https://images.unsplash.com/photo-1579584425555-c3ce17fd4351?q=80&w=800' %>" 
                alt="<%= product.name %>" 
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#12141A] via-transparent to-transparent"></div>
              
              <!-- Privilege Badge -->
              <span class="absolute top-4 left-4 text-[10px] font-sans tracking-[0.2em] text-[#0B0C10] font-bold uppercase bg-gold px-2.5 py-1">
                Seasonal Privilege
              </span>
            </div>

            <!-- Details -->
            <div class="p-6 sm:p-8 flex flex-col flex-1 justify-between gap-6">
              <div class="space-y-3">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-serif text-xl sm:text-2xl uppercase tracking-[0.05em] text-[#F5F5F0] group-hover:text-gold transition-colors">
                    <%= product.name %>
                  </h3>
                  <div class="text-right">
                    <span class="font-serif text-xl text-gold font-light block">
                      $<%= parseFloat(product.price).toFixed(2) %>
                    </span>
                  </div>
                </div>

                <p class="font-serif italic text-sand-muted text-sm leading-relaxed line-clamp-2">
                  <%= product.description || 'Rare oceanic cuts prepared in strictly limited allocations for this week.' %>
                </p>
              </div>

              <!-- Action Link -->
              <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                <span class="text-[10px] uppercase tracking-[0.2em] text-sand-muted font-sans">
                  Limited Daily Counter
                </span>

                <button 
                  onclick="quickAddToBag(this)"
                  title="Claim Privilege"
                  class="px-4 py-2 border border-gold/50 text-gold hover:bg-gold hover:text-[#0B0C10] transition-all text-xs uppercase tracking-[0.2em] flex items-center gap-2"
                >
                  <i class="fa-solid fa-plus text-[10px]"></i>
                  <span>Order</span>
                </button>
              </div>
            </div>

          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full py-20 text-center text-sand-muted font-serif text-xl">
          Seasonal flights are currently fully booked. Please check back for the new moon menu.
        </div>
      <% } %>
    </div>

  </div>
</div>

<script>
  async function quickAddToBag(btn) {
    const card = btn.closest('.dish-card');
    if (!card) return;
    const productId = card.getAttribute('data-dish-id');
    const name = card.getAttribute('data-dish-name');

    try {
      const res = await fetch('/api/cart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId: productId })
      });
      if (res.status === 401) {
        showToast('Please sign in to order dishes.', 'error');
        setTimeout(() => window.location.href = '/login', 1500);
        return;
      }
      const data = await res.json();
      if (res.ok) {
        showToast(`${name} added to your dining bag.`, 'success');
        updateBagBadge();
      } else {
        showToast(data.error || 'Unable to add dish', 'error');
      }
    } catch (err) {
      showToast('Network error adding to bag', 'error');
    }
  }

  async function updateBagBadge() {
    try {
      const res = await fetch('/api/cart');
      if (res.ok) {
        const items = await res.json();
        const countBadge = document.getElementById('cart-item-count');
        if (countBadge) {
          const totalCount = items.reduce((sum, item) => sum + (item.quantity || 1), 0);
          countBadge.textContent = totalCount;
        }
      }
    } catch (err) {}
  }
  document.addEventListener('DOMContentLoaded', updateBagBadge);
</script>
