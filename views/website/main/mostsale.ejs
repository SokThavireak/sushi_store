<!-- SECTION 3: LA SIGNATURE / LES PLATS (CULINARY SHOWCASE GALLERY) -->
<section id="culinary-showcase" class="py-24 sm:py-32 bg-[#0B0C10] relative">
  
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16">
    
    <!-- Section Header with Editorial Serif & Gold Hairline -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <span class="text-[10px] sm:text-xs uppercase tracking-[0.3em] text-gold font-sans block mb-3">
        La Signature · 厳選料理
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl uppercase tracking-[0.12em] text-[#F5F5F0] font-light gold-hairline">
        Les Créations Du Chef
      </h2>
      <p class="font-serif italic text-sand-muted text-base sm:text-lg mt-8 leading-relaxed">
        Rare oceanic treasures, seasoned with 10-year aged soy, fresh mountain wasabi, and citrus yuzu kosho.
      </p>
    </div>

    <!-- Category Filter Tabs with Gold Dot Indicator -->
    <div class="flex items-center justify-center gap-3 sm:gap-6 flex-wrap mb-14 border-b border-white/10 pb-6">
      <button 
        onclick="filterEditorialCategory('all', this)"
        class="cat-tab-btn px-4 py-2 text-xs uppercase tracking-[0.24em] transition-all flex items-center gap-2 text-gold font-semibold"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-gold cat-indicator"></span>
        <span>Tout / All</span>
      </button>

      <% 
        const uniqueCategories = (typeof products !== 'undefined' && products.length) 
          ? [...new Set(products.map(p => p.category).filter(Boolean))] 
          : ['Roll', 'Nigiri', 'Sashimi', 'Set', 'Ramen'];
      %>

      <% uniqueCategories.forEach(cat => { %>
        <button 
          onclick="filterEditorialCategory('<%= cat.toLowerCase() %>', this)"
          class="cat-tab-btn px-4 py-2 text-xs uppercase tracking-[0.24em] text-sand-muted hover:text-sand transition-all flex items-center gap-2"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-transparent cat-indicator"></span>
          <span><%= cat %></span>
        </button>
      <% }) %>
    </div>

    <!-- Fine-Dining Culinary Editorial Grid -->
    <div id="dishes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      <% if (typeof products !== 'undefined' && products.length > 0) { %>
        <% products.forEach((dish, idx) => { %>
          <div 
            class="dish-card group relative bg-[#12141A] border border-white/5 hover:border-gold/30 transition-all duration-700 flex flex-col justify-between"
            data-category="<%= (dish.category || '').toLowerCase() %>"
            data-dish-id="<%= dish.id %>"
            data-dish-name="<%= dish.name %>"
            data-dish-price="<%= parseFloat(dish.price).toFixed(2) %>"
            data-dish-category="<%= dish.category || 'Chef Selection' %>"
            data-dish-image="<%= dish.image_url || 'https://images.unsplash.com/photo-1579584425555-c3ce17fd4351?q=80&w=800' %>"
            data-dish-desc="<%= dish.description || 'Pristine coastal catch, seasoned akasu sushi rice, house-brewed nikiri glaze, and micro-herbs.' %>"
          >
            <!-- Image Frame with Slow Fluid Hover Zoom & Gradient Scrim -->
            <div class="dish-image-frame relative aspect-[4/3] w-full overflow-hidden bg-black/60">
              <img 
                src="<%= dish.image_url || 'https://images.unsplash.com/photo-1579584425555-c3ce17fd4351?q=80&w=800' %>" 
                alt="<%= dish.name %>"
                loading="lazy"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#12141A] via-transparent to-black/30"></div>

              <!-- Kanji Watermark Badge -->
              <span class="absolute top-4 right-4 text-xs font-serif tracking-[0.2em] text-white/40 uppercase bg-black/40 px-2.5 py-1 backdrop-blur-md border border-white/10">
                <%= (dish.category || '寿司').toUpperCase() %>
              </span>

              <% if (dish.is_best_seller) { %>
                <span class="absolute top-4 left-4 text-[10px] font-sans tracking-[0.2em] text-gold uppercase bg-gold/15 px-2.5 py-1 backdrop-blur-md border border-gold/40">
                  Signature
                </span>
              <% } %>
            </div>

            <!-- Culinary Details & Tasting Notes -->
            <div class="p-6 sm:p-8 flex flex-col flex-1 justify-between gap-6">
              <div class="space-y-3">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-serif text-2xl tracking-[0.05em] uppercase text-[#F5F5F0] group-hover:text-gold transition-colors">
                    <%= dish.name %>
                  </h3>
                  <span class="font-serif text-xl text-gold font-light shrink-0">
                    $<%= parseFloat(dish.price).toFixed(2) %>
                  </span>
                </div>

                <p class="font-serif italic text-sand-muted text-sm sm:text-base leading-relaxed line-clamp-2">
                  <%= dish.description || 'Pristine ocean fish, seasoned sushi-meshi, brushed with master nikiri soy & yuzu essence.' %>
                </p>
              </div>

              <!-- Action Link / Ghost Button Triggering Modal -->
              <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                <button 
                  onclick="openDishModal(this.closest('.dish-card'))"
                  class="text-[11px] font-sans uppercase tracking-[0.24em] text-sand hover:text-gold transition-colors flex items-center gap-2"
                >
                  <span>Voir L'Assiette</span>
                  <i class="fa-solid fa-arrow-right text-[9px] transition-transform group-hover:translate-x-1"></i>
                </button>

                <button 
                  onclick="quickAddToBag(this)"
                  title="Ajouter au panier"
                  class="w-9 h-9 border border-white/10 hover:border-gold hover:bg-gold hover:text-[#0B0C10] text-gold transition-all flex items-center justify-center text-xs"
                >
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>
            </div>

          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full py-16 text-center text-sand-muted font-serif text-lg">
          No courses currently listed. Please check back shortly.
        </div>
      <% } %>
    </div>

  </div>

</section>
