<!-- FINE DINING DISH DETAIL MODAL (SLIDING OVERLAY) -->
<div id="dish-modal" class="fixed inset-0 z-[70] hidden items-center justify-center p-4 sm:p-6 bg-black/80 backdrop-blur-md">
  <div class="relative w-full max-w-2xl bg-[#12141A] border border-white/10 shadow-2xl overflow-hidden animate-modal-up">
    
    <!-- Close Button -->
    <button onclick="closeDishModal()" class="absolute top-4 right-4 z-20 w-8 h-8 rounded-full bg-black/60 border border-white/15 text-sand hover:text-gold hover:border-gold flex items-center justify-center transition-colors">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>

    <div class="grid grid-cols-1 sm:grid-cols-2">
      <!-- Modal Dish Photo -->
      <div class="relative aspect-square sm:aspect-auto w-full bg-black">
        <img id="modal-dish-img" src="" alt="" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#12141A] via-transparent to-transparent"></div>
      </div>

      <!-- Modal Info & Bag Adding -->
      <div class="p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <span id="modal-dish-category" class="text-[10px] tracking-[0.26em] uppercase text-gold font-sans block mb-2">Category</span>
          <h3 id="modal-dish-title" class="font-serif text-2xl uppercase tracking-[0.08em] text-white mb-2">Dish Name</h3>
          <p id="modal-dish-price" class="font-serif text-2xl text-gold font-light mb-4">$0.00</p>
          <p id="modal-dish-desc" class="font-serif italic text-sand-muted text-sm leading-relaxed mb-6">Description</p>
        </div>

        <div class="space-y-4 pt-4 border-t border-white/5">
          <button id="modal-add-btn" onclick="" class="btn-haute-solid w-full">
            <span>Add To Bag</span>
            <i class="fa-solid fa-bag-shopping text-[10px] ml-2"></i>
          </button>
          <button onclick="closeDishModal()" class="text-[10px] uppercase tracking-[0.2em] text-sand-muted hover:text-sand w-full text-center block">
            Return to Menu
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  // CATEGORY FILTERING SCRIPT
  function filterEditorialCategory(cat, element) {
    const buttons = document.querySelectorAll('.cat-tab-btn');
    buttons.forEach(btn => {
      btn.classList.remove('text-gold', 'font-semibold');
      btn.classList.add('text-sand-muted');
      const dot = btn.querySelector('.cat-indicator');
      if (dot) dot.classList.replace('bg-gold', 'bg-transparent');
    });

    element.classList.add('text-gold', 'font-semibold');
    element.classList.remove('text-sand-muted');
    const activeDot = element.querySelector('.cat-indicator');
    if (activeDot) activeDot.classList.replace('bg-transparent', 'bg-gold');

    const cards = document.querySelectorAll('.dish-card');
    cards.forEach(card => {
      const cardCat = card.getAttribute('data-category');
      if (cat === 'all' || cardCat.includes(cat)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  // DISH DETAIL MODAL SCRIPT
  function openDishModal(card) {
    const modal = document.getElementById('dish-modal');
    document.getElementById('modal-dish-img').src = card.getAttribute('data-dish-image');
    document.getElementById('modal-dish-title').textContent = card.getAttribute('data-dish-name');
    document.getElementById('modal-dish-category').textContent = card.getAttribute('data-dish-category');
    document.getElementById('modal-dish-price').textContent = '$' + card.getAttribute('data-dish-price');
    document.getElementById('modal-dish-desc').textContent = card.getAttribute('data-dish-desc');

    const dishId = card.getAttribute('data-dish-id');
    const dishName = card.getAttribute('data-dish-name');
    document.getElementById('modal-add-btn').onclick = function() {
      quickAddToBag(dishId, dishName);
      closeDishModal();
    };

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeDishModal() {
    const modal = document.getElementById('dish-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  // QUICK ADD TO BAG FUNCTION
  async function quickAddToBag(productId, name) {
    try {
      const res = await fetch('/api/cart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId: productId })
      });
      if (res.status === 401) {
        showToast('Please sign in to order dishes.', 'error');
        setTimeout(() => window.location.href = '/login', 1500);
        return;
      }
      const data = await res.json();
      if (res.ok) {
        showToast(`${name} added to your dining bag.`, 'success');
        updateBagBadge();
      } else {
        showToast(data.error || 'Unable to add dish', 'error');
      }
    } catch (err) {
      showToast('Network error adding to bag', 'error');
    }
  }

  async function updateBagBadge() {
    try {
      const res = await fetch('/api/cart');
      if (res.ok) {
        const items = await res.json();
        const countBadge = document.getElementById('cart-item-count');
        if (countBadge) {
          const totalCount = items.reduce((sum, item) => sum + (item.quantity || 1), 0);
          countBadge.textContent = totalCount;
        }
      }
    } catch (err) {}
  }
  document.addEventListener('DOMContentLoaded', updateBagBadge);
</script>
